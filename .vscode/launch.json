{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico W Debug (SWD probe)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/mtkernel_3.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "RP2040",
            "configFiles": ["interface/cmsis-dap.cfg", "target/rp2040.cfg"],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.0/src/rp2040/hardware_regs/RP2040.svd",
            "runToEntryPoint": "usermain",
            "preLaunchTask": "Compile Project",
            "serverpath": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "searchDir": ["${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts"]
        }
    ]
}
